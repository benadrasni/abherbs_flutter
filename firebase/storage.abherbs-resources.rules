rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /families/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /offline/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /misc/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Client path: observations/{uid}/{Plant_name}/{file}.jpg
    // Public read: shared Sightings. Private Seen photos use private/.
    match /observations/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Field Guide copies. The object key mirrors observations/{uid}/… under
    // private/{uid}/…, including a Latin name that is not in the book.
    match /private/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
