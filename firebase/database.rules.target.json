{
  "rules": {
    "counts": { ".read": true, ".write": false },
    "counts_4": { ".read": true, ".write": false },
    "counts_4_v2": { ".read": true, ".write": false },
    "counts_4_v3": { ".read": true, ".write": false },
    "counts_new": { ".read": true, ".write": false },

    "lists": { ".read": true, ".write": false },
    "lists_4": { ".read": true, ".write": false },
    "lists_4_v2": { ".read": true, ".write": false },
    "lists_4_v3": { ".read": true, ".write": false },
    "lists_new": { ".read": true, ".write": false },
    "lists_custom": { ".read": true, ".write": false },

    "plants": { ".read": true, ".write": false },
    "plants_v2": { ".read": true, ".write": false },
    "plants_headers": {
      ".read": true,
      ".write": false,
      ".indexOn": "name"
    },
    "plants_headers_v3": {
      ".read": true,
      ".write": false,
      ".indexOn": "name"
    },
    "plants_to_update": { ".read": true, ".write": false },
    "catalog_changes": { ".read": true, ".write": false },
    "plants_new": { ".read": true, ".write": false },
    "families_to_update": { ".read": true, ".write": false },

    "translations": { ".read": true, ".write": false },
    "translations_taxonomy": { ".read": true, ".write": false },
    "translations_app": { ".read": true, ".write": false },

    "search": { ".read": true, ".write": false },
    "search_v2": { ".read": true, ".write": false },
    "search_v3": { ".read": true, ".write": false },
    "search_new": { ".read": true, ".write": false },
    "search_photo": { ".read": true, ".write": false },
    "search_photo_new": { ".read": true, ".write": false },

    "APG III": { ".read": true, ".write": false },
    "APG IV": { ".read": true, ".write": false },
    "APG IV_v2": { ".read": true, ".write": false },
    "APG IV_v3": { ".read": true, ".write": false },

    "offline": { ".read": true, ".write": false },
    "messages": { ".read": true, ".write": false },
    "synonyms": { ".read": true, ".write": false },
    "versions": { ".read": true, ".write": false },
    "promotions": { ".read": true, ".write": false },
    "web": { ".read": true, ".write": false },
    "settings": { ".read": true, ".write": false },

    "observations": {
      "by users": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          "by date": {
            "list": {
              ".indexOn": ["status", "order"]
            }
          }
        }
      },
      "public": {
        ".read": true,
        "by date": {
          "list": {
            ".indexOn": "status"
          }
        }
      },
      "logs": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false,
          ".indexOn": "time"
        }
      }
    },

    "credits": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },

    "photo_quota": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },

    "ad_rewards": { ".read": false, ".write": false },
    "anonymous_daily": { ".read": false, ".write": false },
    "photo_name_tally": { ".read": false, ".write": false },
    "purchase_proofs": { ".read": false, ".write": false },
    "store_accounts": { ".read": false, ".write": false },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "token": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 4096"
        },
        "favorites": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "entitlements": { ".write": false }
      }
    },

    "users_photo_search": {
      "$lang": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    }
  }
}
